# --- LLM API keys---
GROQ_API_KEY=
GEMINI_API_KEY=
NVIDIA_API_KEY=

# --- MySQL---
MYSQL_ROOT_PASSWORD=password
MYSQL_DATABASE=cvextract

# --- Database URL ---
# Khi chạy Docker Compose: giữ host = mysql (tên service)
DATABASE_URL=mysql+aiomysql://root:password@mysql:3306/cvextract

# --- Qdrant ---
# Docker Compose: http://qdrant:6333
QDRANT_URL=http://qdrant:6333
#   cv_chunks_v1: paraphrase-multilingual-MiniLM-L12-v2 (384d)
QDRANT_COLLECTION=cv_chunks_v1

# --- Embedding (bi-encoder, sentence-transformers) ---
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIM=384

# --- Reranker (cross-encoder). Để rỗng để tắt re-rank ---
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# --- Parsing LLM ---
# Provider: groq | gemini | nvidia
PARSING_LLM_PROVIDER=groq
PARSING_LLM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- Conversational chat ---
CHAT_LLM_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Session TTL (giờ)
CHAT_SESSION_TTL_HOURS=24
# Số message cuối load vào condense prompt làm context
CHAT_HISTORY_LAST_N=10
# Top hit score < threshold thì bot refuse, không gọi answer LLM
CHAT_REFUSAL_SCORE_THRESHOLD=0.3
